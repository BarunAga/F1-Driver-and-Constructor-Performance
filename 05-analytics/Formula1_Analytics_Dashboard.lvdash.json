        "SELECT * FROM formula1.gold.view_constructor_standings"
      ]
    },
    {
      "name": "75d48da1",
      "displayName": "dominant_drivers",
      "queryLines": [
        "WITH dominant_drivers AS ( \r\n",
        "\r\n",
        "SELECT  driver_name,\r\n",
        "        SUM(total_points) AS total_points,\r\n",
        "        SUM(number_of_wins) AS total_wins,\r\n",
        "        SUM(number_of_podiums) AS total_podiums,\r\n",
        "        SUM(race_start) AS race_number,\r\n",
        "        SUM(CASE WHEN standing_position = 1 THEN 1 ELSE 0 END) AS total_championships\r\n",
        "FROM formula1.gold.view_driver_standings\r\n",
        "\r\n",
        "GROUP BY driver_name\r\n",
        "HAVING total_championships > 0\r\n",
        "\r\n",
        ")\r\n",
        "SELECT  driver_name,\r\n",
        "        total_points,\r\n",
        "        total_wins,\r\n",
        "        total_podiums,\r\n",
        "        race_number,\r\n",
        "        total_championships,\r\n",
        "        (100*total_championships + 7*total_wins + 3*total_podiums) AS greatness_score\r\n",
        "FROM dominant_drivers\r\n",
        "ORDER BY greatness_score DESC"
      ],
      "catalog": "formula1",
      "schema": "gold"
    },
    {
      "name": "37595c4c",
      "displayName": "dominant_constructors",
      "queryLines": [
        "WITH dominant_constructors AS ( \r\n",
        "\r\n",
        "SELECT  constructor_name,\r\n",
        "        SUM(total_points) AS total_points,\r\n",
        "        SUM(number_of_wins) AS total_wins,\r\n",
        "        SUM(number_of_podiums) AS total_podiums,\r\n",
        "        SUM(race_start) AS race_number,\r\n",
        "        SUM(CASE WHEN standing_position = 1 THEN 1 ELSE 0 END) AS total_championships\r\n",
        "FROM formula1.gold.view_constructor_standings\r\n",
        "\r\n",
        "GROUP BY constructor_name\r\n",
        "HAVING total_championships > 0\r\n",
        "\r\n",
        ")\r\n",
        "SELECT  constructor_name,\r\n",
        "        total_points,\r\n",
        "        total_wins,\r\n",
        "        total_podiums,\r\n",
        "        race_number,\r\n",
        "        total_championships,\r\n",
        "        (100*total_championships + 7*total_wins + 3*total_podiums) AS greatness_score\r\n",
        "FROM dominant_constructors\r\n",
        "ORDER BY greatness_score DESC"
      ],
      "catalog": "formula1",
      "schema": "gold"
    }
  ],
